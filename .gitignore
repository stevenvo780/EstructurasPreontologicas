# Node modules y caches NPM (subproyecto ST)
08-consistencia-st/node_modules/
08-consistencia-st/.npm/
08-consistencia-st/npm-debug.log*

# Entorno virtual Python (corpus EDI)
09-simulaciones-edi/.venv/
09-simulaciones-edi/**/__pycache__/
09-simulaciones-edi/**/*.pyc
09-simulaciones-edi/**/*.pyo

# Cache de datos descargados voluminosos (se regeneran ejecutando los casos)
09-simulaciones-edi/data_cache/
09-simulaciones-edi/**/data_cache/
# NOTA 2026-09-28: los inputs por caso (*/data/*.csv + FETCH_MANIFEST*.json, ~0.4MB)
# SI se versionan como fixtures exactos para validacion independiente bit-a-bit.
# Solo data_cache/ (descargas pesadas regenerables via data.py) queda ignorado.

# Outputs antiguos no canónicos (los canónicos están versionados)
09-simulaciones-edi/**/outputs/*.tmp
09-simulaciones-edi/**/outputs/_old/

# Archivos del sistema
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Logs y reports temporales
*.log
*.tmp
*.bak

# Python bytecode (web_tesis y otros)
**/__pycache__/
*.pyc
*.pyo

# Bibliografía (libros de terceros con copyright; no versionados)
07-bibliografia/*.pdf
07-bibliografia/*.PDF


# React build artifacts
web_react/node_modules/
web_react/.vite/
# dist/ se commitea para que Vercel/FastAPI sirvan los assets compilados

# El build de Vite se sincroniza a /public para Vercel; web_react/dist es intermedio
web_react/dist/
.vercel

# Harness — caches y reportes locales (no a git)
.cache_harness/
harness/reports/
harness/state.json
harness/state/
harness/__pycache__/
harness/**/__pycache__/
harness/**/*.pyc

# Logs y residuos del daemon viejo (deprecado 2026-05-11)
Bitacora/*-continuous-run/daemon.log
Bitacora/*-continuous-run/daemon.out
Bitacora/*-continuous-run/workers/
